# PM Production Environment Variables
# このファイルを .env にコピーして値を設定してください

# Database設定（共通MySQLコンテナに接続）
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=pm_db

# AI集計専用DBユーザー（通常のDB_USERを流用しない）
AI_DB_HOST=mysql
AI_DB_PORT=3306
AI_DB_NAME=pm_db
AI_DB_USER=pm_ai_reader
AI_DB_PASSWORD=
AI_DB_SSL_CA=
AI_DB_SSL_CERT=
AI_DB_SSL_KEY=

# 分析案用Redis。本番はComposeが内部サービスURLを渡す。
# DockerなしのWindows開発では pm_backend/.env に redis://127.0.0.1:6379/0 を設定する。
AI_ANALYSIS_REDIS_URL=

# Django設定
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.15

# 社内AIチャット（DeepSeek API）
# APIキーはGitに含めず、実際の .env にだけ設定してください
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com

# CORS/CSRF設定（本番PCのIPアドレスを追加）
# settings.pyのCORS_ALLOWED_ORIGINSとCSRF_TRUSTED_ORIGINSにも追加が必要
